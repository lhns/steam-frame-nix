        "hapticEffects": {
          "checkOnly": true,
          "module": { "includes": ["e[e.Snap=3]=\"Snap\",e[e.Sliding=4]=\"Sliding\",e[e.SlidingEdge=5]=\"SlidingEdge\""] }
        },
        "hapticCall": {
          "checkOnly": true,
          "module": { "includes": ["TriggerOverlayHapticEffect(VRHTML.VROverlay.ThisOverlayHandle(),"] }
        },
        "sceneGraphNodes": {
