{
  "bundles": {
    "steamui": {
      "description": "Steam client UI (SharedJSContext and its popups, e.g. the VR keyboard and dashboard bar)",
      "chunkGlobal": "webpackChunksteamui",
      "dir": "~/.local/share/Steam/steamui",
      "html": "index.html",
      "exclude": "^localization/",
      "styles": "css"
    },
    "vrwebui-systemui": {
      "description": "SteamVR dashboard (vrwebhelper page systemui)",
      "chunkGlobal": "webpackChunkvrwebui",
      "dir": "/opt/steamvr/resources/webinterface/dashboard",
      "html": "systemui.html"
    }
  },
  "patches": {
    "steam-keyboard-patch": {
      "bundle": "steamui",
      "modules": {
        "layouts": {
          "module": { "includes": ["name:\"qwerty\"", "rgLayout:", "GetKeyboardLayoutSettings"] },
          "exports": {
            "currentLayout": {
              "type": "function", "length": 0,
              "includes": ["GetKeyboardLayoutSettings", "currentLayout"],
              "excludes": ["selectedLayouts", "SetKeyboardLayout"]
            },
            "enabledLayouts": {
              "type": "function", "length": 0,
              "includes": ["GetKeyboardLayoutSettings", "selectedLayouts"],
              "excludes": ["useState", "SetKeyboardLayout", "SetValidKeyboardLayouts"]
            },
            "arrowLeft": { "type": "object", "props": { "key": "ArrowLeft" } },
            "arrowUp": { "type": "object", "props": { "key": "ArrowUp" } },
            "arrowDown": { "type": "object", "props": { "key": "ArrowDown" } },
            "arrowRight": { "type": "object", "props": { "key": "ArrowRight" } }
          },
          "expects": ["Half", "rgLayout:", "leftActionButton"]
        },
        "vrStatus": {
          "module": { "includes": ["get VRKeyboardStatus()"] },
          "exports": {
            "holder": { "type": "object", "getters": ["VRKeyboardStatus"] }
          },
          "expects": ["bIsOpen:", "sOverlayKey", "unAppID"]
        },
        "keyboardManager": {
          "module": { "includes": ["SendClientPasteCommand(){", "HandleVirtualKeyDown(", "GetEnterKeyLabel("] },
          "exports": {
            "VirtualKeyboardManager": {
              "type": "class",
              "protoMethods": ["HandleVirtualKeyDown", "GetEnterKeyLabel", "SendClientPasteCommand"]
            }
          },
          "expects": ["m_ActiveElementProps", "m_bDismissOnEnter", "m_Instance", "GetVROverlayKey()",
            "MainRunningAppID", "ControllerKeyboardSendText"]
        },
        "keyboardComponent": {
          "checkOnly": true,
          "module": { "includes": ["TypeKeyInternal(", "toggleStates", "standardLayout"] },
          "expects": ["\"data-key\"", "\"data-key-row\"", "HandleVirtualKeyDown", "RenderStandardKeyboard(",
            "rgLayout:", "s_longPressThreshold", "s_longPressRepeatThreshold", "m_mapTouched",
            "CancelLongPressTimer(){", "DismissLongPress(){", "ClearHoldTarget(){", "\"Backspace\""]
        },
        "popupManager": {
          "checkOnly": true,
          "module": { "includes": ["g_PopupManager", "GetPopups()"] }
        }
      }
    },
    "launcher-menu-order": {
      "bundle": "steamui",
      "modules": {
        "programList": {
          "checkOnly": true,
          "module": { "includes": ["ScanForInstalledNonSteamApps("] }
        }
      }
    },
    "launcher-menu-launch": {
      "bundle": "steamui",
      "modules": {
        "dashboardBar": {
          "checkOnly": true,
          "module": { "includes": ["allowLaunchProgram", "refBarPopopHandle", "#VRDashboard_LaunchNonSteamApp"] },
          "expects": ["LaunchNonSteamApp(", "\"VRDashboardBarSmallButton\"", "BPopupOpen()", "closePopup()"]
        }
      }
    },
    "launcher-menu-pinned-desktop": {
      "bundle": "steamui",
      "modules": {
        "dashboardBar": {
          "checkOnly": true,
          "module": { "includes": ["allowLaunchProgram", "refBarPopopHandle", "#VRDashboard_LaunchNonSteamApp"] },
          "expects": ["header:", "strExePath", "rctContents"]
        },
        "popupNames": {
          "checkOnly": true,
          "module": { "includes": ["\"valve.steam.gamepadui.barpopup\""] }
        }
      }
    },
    "launcher-menu-grid": {
      "bundle": "steamui",
      "modules": {
        "dashboardBar": {
          "checkOnly": true,
          "module": { "includes": ["allowLaunchProgram", "refBarPopopHandle", "#VRDashboard_LaunchNonSteamApp"] },
          "expects": ["key:\"programs\"", "key:\"windows\"", "header:"]
        },
        "popupNames": {
          "checkOnly": true,
          "module": { "includes": ["\"valve.steam.gamepadui.barpopup\""] }
        },
        "scrollFade": {
          "checkOnly": true,
          "module": { "includes": ["ScrollFade", "ScrolledToTop", "ScrolledToBottom", "strClassNamesForScrollable"] },
          "expects": ["scrollTop<=1", "clientHeight+1"]
        },
        "scrollFadeClasses": {
          "checkOnly": true,
          "module": { "includes": ["ScrollFade:\"", "ScrolledToTop:\"", "ScrolledToBottom:\""] }
        },
        "scrollFadeStyle": {
          "checkOnly": true,
          "stylesheet": { "includes": [
            "mask-image:linear-gradient(to bottom, transparent 0%, black var(--scroll-fade-size), black calc(100% - var(--scroll-fade-size)), transparent 100%)",
            "--scroll-fade-size:"
          ] }
        },
        "scrollShadowStyle": {
          "checkOnly": true,
          "stylesheet": { "includes": [
            "z-index:9001;height:0;box-shadow:0 0 40px 40px #0e141b;transition:opacity .15s ease-out;pointer-events:none"
          ] }
        }
      }
    },
    "launcher-menu-show-all": {
      "bundle": "steamui",
      "modules": {
        "devModeApps": {
          "module": { "includes": ["\"developer_mode_enabled\"", "\"firewall-config\"", "\"vrurlhandler\"", "\"Install Chromium\""] },
          "exports": {
            "devModeOnly": { "type": "object", "has": ["push"], "props": { "0": "firewall-config" } }
          },
          "expects": ["\"konsole\"", "\"systemsettings\"", "\"dolphin\"", "\"plasma-discover\""]
        },
        "launcherFilter": {
          "checkOnly": true,
          "module": {
            "includes": ["allowLaunchProgram", "#VRDashboard_LaunchNonSteamApp", "strExePath.endsWith(\"/\"+"],
            "regex": ["/\\|\\|[\\w$]+\\.push\\(\\.\\.\\.[\\w$]+\\.[\\w$]+\\),[\\w$]+\\.filter\\(/"]
          },
          "expects": ["strAppName==", "strExePath=="]
        }
      }
    },
    "dashboard-windows": {
      "bundle": "vrwebui-systemui",
      "modules": {
        "mailbox": {
          "module": { "includes": ["\"mailbox_send \"", "WebSocketSend(", "\"vrcompositor_systemlayer\""] },
          "exports": {
            "Mailbox": { "type": "class", "protoMethods": ["SendMessage", "SendMessageAndWaitForResponse", "RegisterHandler"] }
          }
        },
        "sceneGraph": {
          "module": { "includes": ["\"update_scene_graph\"", "NextSGID()", "scene_graph:"] },
          "exports": {
            "resend": { "type": "function", "length": 0, "includes": ["NextSGID()", "setTimeout"] }
          },
          "expects": ["\"vrcompositor_systemlayer\"", ".SendMessage("]
        },
        "windowFrame": {
          "checkOnly": true,
          "module": { "includes": ["\"frame-resize-scale-max\"", "\"frame-resize-scale-min\""] }
        },
        "grabScale": {
          "checkOnly": true,
          "module": { "includes": ["\"grab-scale\"", "\"min-distance\"", "\"max-distance\""] }
        }
      }
    },
    "steam-close-button": {
      "bundle": "vrwebui-systemui",
      "modules": {
        "mobx": {
          "module": { "includes": ["runInAction:()=>", "makeObservable:()=>", "reaction:()=>"] }
        },
        "dock": {
          "module": { "includes": ["e[e.Dashboard=1]=\"Dashboard\",e[e.LeftHand=2]=\"LeftHand\""] },
          "exports": {
            "EDockLocation": { "type": "object", "props": { "Dashboard": 1, "LeftHand": 2, "RightHand": 3, "World": 4, "Theater": 5 } }
          }
        },
        "closing": {
          "module": { "includes": ["this.componentName=\"closing\"", "closeMethodPriority"] },
          "exports": {
            "Closing": { "type": "class", "includes": ["componentName=\"closing\"", "RequestClose()"] }
          },
          "expects": ["defaultComponentProps=", "null!=this.componentProps.onCloseRequested", "get showCloseButton()",
            "m_bShowSpinner=!0"]
        },
        "frameComponent": {
          "checkOnly": true,
          "module": { "includes": ["this.defaultComponentProps", "FramePageComponent '"] },
          "expects": ["get componentProps()", ".componentProps)", "[this.componentName]"]
        },
        "frame": {
          "checkOnly": true,
          "module": { "includes": ["e[e.Alive=2]=\"Alive\""] },
          "expects": ["this.m_eState=", "this.closing=", "this.docking=", "this.tab=", "get isActiveDashboardFrame()",
            "this.props=", "get associatedSummonOverlayKeys()"]
        },
        "frameStore": {
          "checkOnly": true,
          "module": { "includes": ["window.FrameStore="] },
          "expects": ["GetFrame(e){"]
        },
        "dashboardStore": {
          "checkOnly": true,
          "module": { "includes": ["window.DashboardStore="] },
          "expects": ["_setActiveFrame(e,t){", "\"_setActiveFrame\"", "get mainSteamFrame()", "m_unMainSteamFrameID",
            "get activeFrameID()", "get activeFrame()", "get isFullyVisible()"]
        },
        "dashboard": {
          "checkOnly": true,
          "module": { "includes": ["window.Dashboard=this", "autoSwitchOverlayIfNeeded(){"] },
          "expects": ["this.autoSwitchOverlayIfNeeded()", "switchToFrameInternal(e,t,r){", "\"hideDashboard\"",
            "visibleInDashboardBar", "this.m_mailbox=",
            "k_sDashboardOverlayDestroyedMessage=\"dashboard_overlay_destroyed\"",
            "k_sDashboardOverlayDestroyedMessage,this.onDashboardOverlayDestroyed)",
            "onDashboardOverlayDestroyed(e){", "&&this.switchToHomeOverlay()}",
            "RegisterHandler(\"show_dashboard_requested\",(e=>this.showDashboardOverlay(",
            "RegisterHandler(\"switch_dashboard_overlay_requested\",(e=>this.showDashboardOverlay(",
            "overlayKey:null==e?void 0:e.overlay_key,sReason:null==e?void 0:e.reason"]
        },
        "mailbox": {
          "checkOnly": true,
          "module": { "includes": ["RegisterHandler(e,t){this.m_oHandlers[e]=t}"] },
          "expects": ["this.m_oHandlers[t.type](t)"]
        },
        "docking": {
          "checkOnly": true,
          "module": { "includes": ["get dockLocation()", "SetDockLocation(e"], "excludes": ["get associatedSummonOverlayKeys()"] },
          "expects": ["sReason:\"SetDockLocation\""]
        },
        "overlayKeys": {
          "checkOnly": true,
          "module": { "includes": ["\"valve.steam.gamepadui.main\"", "\"valve.steam.gamepadui.appoverlay\""] }
        }
      }
    },
    "window-curvature": {
      "bundle": "vrwebui-systemui",
      "modules": {
        "mobx": {
          "module": { "includes": ["runInAction:()=>", "makeObservable:()=>", "reaction:()=>"] }
        },
        "dock": {
          "module": { "includes": ["e[e.Dashboard=1]=\"Dashboard\",e[e.LeftHand=2]=\"LeftHand\""] },
          "exports": {
            "EDockLocation": { "type": "object", "props": { "Dashboard": 1, "LeftHand": 2, "RightHand": 3, "World": 4, "Theater": 5 } }
          }
        },
        "mailbox": {
          "module": { "includes": ["\"mailbox_send \"", "WebSocketSend(", "\"vrcompositor_systemlayer\""] },
          "exports": {
            "Mailbox": { "type": "class", "protoMethods": ["SendMessage", "SendMessageAndWaitForResponse", "RegisterHandler"] }
          }
        },
        "sceneGraph": {
          "module": { "includes": ["\"update_scene_graph\"", "NextSGID()", "scene_graph:"] },
          "exports": {
            "resend": { "type": "function", "length": 0, "includes": ["NextSGID()", "setTimeout"] }
          },
          "expects": ["\"vrcompositor_systemlayer\"", ".SendMessage("]
        },
        "curvature": {
          "module": { "includes": ["this.componentName=\"curvature\"", "ToggleCurvature(){"] },
          "exports": {
            "Curvature": { "type": "class", "includes": ["componentName=\"curvature\"", "m_bCurveOverride"] }
          },
          "expects": ["get curvatureTransformOriginID(){return`frame:${this.frame.frameID}:curvature-origin`}",
            "ToggleCurvature(){this.m_bCurveOverride=!this.shouldCurve}", "get shouldCurve()",
            "get curvatureOriginDistance(){return this.shouldCurve?", ".curvatureDistance:1e3}", "translation:{z:"]
        },
        "actions": {
          "module": { "includes": ["window.dashboardActionStore="] },
          "exports": {
            "store": { "type": "object", "methods": ["GetAction", "BIsVRLinkRemoteAction"] }
          },
          "expects": ["get partialParams()", "get protoForSteam()", "m_PartialParams"]
        },
        "frameControlsClasses": {
          "module": { "includes": ["FrameControlsContainer:\"", "AdditionalOptionsRow:\"", "AdditionalOptionsLabel:\""] },
          "exports": {
            "row": { "type": "string", "regex": ["_AdditionalOptionsRow_"] },
            "label": { "type": "string", "regex": ["_AdditionalOptionsLabel_"] }
          }
        },
        "frameControls": {
          "checkOnly": true,
          "module": { "includes": ["legacy-frame-controls-additional-options-", "controlAdditionalOptionsItems.filter("] },
          "expects": ["id:`legacy-frame-controls-additional-options-${", "isControlAdditionalOptionsOpen",
            ".AdditionalOptionsRow,", ".AdditionalOptionsLabel},", "display_name", "invocation", "onClick:()=>{", "onMouseDown:",
            "id:`legacy-frame-controls-${", "items_for_bottom_frame_controls", "control:e,", ".TopCenter,meters_per_pixel:"]
        },
        "curvatureAction": {
          "checkOnly": true,
          "module": { "includes": ["\"#ToggleCurvatureTooltip\""] },
          "expects": ["icon:{enum:40},icon_active:{enum:39},invocation:2", ".curvature.ToggleCurvature()"]
        },
        "frame": {
          "checkOnly": true,
          "module": { "includes": ["e[e.Alive=2]=\"Alive\""] },
          "expects": ["this.curvature=", "this.docking=", "get isControlAdditionalOptionsOpen()",
            "get controlAdditionalOptionsItems()", "get associatedSummonOverlayKeys()",
            "get protoForSteam()", "isCurrentlyVisible"]
        },
        "docking": {
          "checkOnly": true,
          "module": { "includes": ["get dockLocation()", "SetDockLocation(e"], "excludes": ["get associatedSummonOverlayKeys()"] },
          "expects": ["get visualDockLocation()"]
