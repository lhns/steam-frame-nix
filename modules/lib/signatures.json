        }
      }
    },
    "frame-controls": {
      "bundle": "vrwebui-systemui",
      "modules": {
        "mobx": {
          "module": { "includes": ["runInAction:()=>", "makeObservable:()=>", "reaction:()=>"] }
        },
        "frame": {
          "module": { "includes": ["m_rgControlsItems_BottomFrameControls", "get protoForSteam()", "SetControlsItems("] },
          "exports": {
            "Frame": { "type": "class", "protoMethods": ["SetControlsItems", "SetControlAdditionalOptionsOpen", "CreateAction"] }
          },
          "expects": ["SetControlsItems(e,t,o){this.m_rgControlsItems_BottomFrameControls=e,this.m_rgControlsItems_TabHoverControls=t,this.m_rgControlsItems_AdditionalOptions=o}",
            "get isControlAdditionalOptionsOpen(){return this.m_bControlAdditionalOptionsOpen&&this.m_rgControlsItems_AdditionalOptions.length>0}",
            "BPanelHasFocus(this.panels.additionalOptionsPanelSGID)", "this.SetControlAdditionalOptionsOpen(!1)", "m_unControlAdditionalOptionsActionID"]
        },
        "actions": {
          "module": { "includes": ["window.dashboardActionStore="] },
