Terminal=false
Type=Application
StartupNotify=true
MimeType=text/plain;application/x-zerosize;text/x-nix;
Icon=org.gnome.gedit
Categories=GNOME;GTK;Utility;TextEditor;
Actions=new-window;new-document;
DBusActivatable=false
X-Flatpak=org.gnome.gedit
StartupWMClass=gedit
X-SteamFrameNix-Source=@SOURCE@

