[Desktop Entry]
Type=Application
Exec=/usr/bin/flatpak run --branch=stable --arch=aarch64 --command=/app/bin/example-remote --file-forwarding org.example.Remote -qwindowtitle %c @@u %u @@
Icon=org.example.Remote
Terminal=false
Name=Example Remote
Name[de]=Beispiel-Fernzugriff
Name[zh_TW]=範例遠端
GenericName=Remote Desktop Client
GenericName[de]=Fernzugriff
Comment=A made-up Qt app (Flatpak) that reads its passwords through the Secret Service
StartupWMClass=example-remote
MimeType=x-scheme-handler/vnc;x-scheme-handler/rdp;application/x-example-remote;
Categories=Qt;KDE;Network;RemoteAccess;
X-KDE-Wayland-Interfaces=org_kde_kwin_keystate
X-Flatpak=org.example.Remote
